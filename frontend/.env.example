# Copy to frontend/.env (local) or set in Vercel → Project → Settings → Environment Variables.
# Everything is optional for local exploration: without DATABASE_URL the API serves its built-in dataset.
# With DATABASE_URL pointing at an empty database, the API creates the tables and starter data itself.

# ─── Database (any PostgreSQL 15+: Neon via Vercel Storage, Supabase, local) ──
# The pooled connection string. Also read from DB_URL, POSTGRES_URL or DB_POSTGRES_URL — the names Vercel's
# Neon integration uses — so whichever prefix was chosen when connecting the database works.
DATABASE_URL="postgresql://{user}:{password}@{host}/{database}?sslmode=require"
# Optional direct (unpooled) connection for prisma db push and seeding from your machine.
DIRECT_URL=""

# ─── Sessions ───────────────────────────────────────────────────────────────
# Signs session cookies and mesh gateway tokens. Strongly recommended; if absent, a key is derived from the
# database connection string (changing the database password then signs everyone out).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated emails that become verified incident administrators on sign-up.
VOLENTIFY_ADMIN_EMAILS=""

# ─── Google OAuth 2.0 ───────────────────────────────────────────────────────
# Authorised redirect URI in Google Cloud Console: {NEXTAUTH_URL}/auth/callback
GOOGLE_CLIENT_ID=""

# ─── AI / ML (all optional — deterministic fallbacks run without them) ──────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"   # retired models are replaced automatically
IMPOSSIBL_API_KEY=""
IMPOSSIBL_API_URL="https://api.impossibl.com/v1/triage"

# ─── Volentify Mesh Android app ─────────────────────────────────────────────
# Shown as "Download the Android app"; the GitHub workflow publishes it at this address.
NEXT_PUBLIC_MESH_APK_URL="https://github.com/Gyanvir/Volentify_pilot/releases/latest/download/volentify-mesh.apk"

NEXT_TELEMETRY_DISABLED=1
